<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Free Fire Profile</title>

  <style>
    

/* =========================
   Global Styles
========================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.error-message {
  margin-bottom: 20px;
  padding: 14px 16px;
  background: #111111;
  color: #eeeeee;
  border: 1px solid #383838;
  border-radius: 10px;
  font-size: 14px;
  line-height: 1.5;
}
:root {
  color-scheme: dark;
  --background: #000000;
  --card-background: #0a0a0a;
  --inner-background: #111111;
  --border-color: #262626;
  --text-color: #f5f5f5;
  --muted-color: #999999;
  --search-red: #e50914;
}

html {
  min-height: 100%;
  background: var(--background);
}

body {
  min-height: 100vh;
  background: var(--background);
  color: var(--text-color);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 15px;
  line-height: 1.5;
}

input,
button {
  font: inherit;
}

button {
  cursor: pointer;
}

/* =========================
   Main Container
========================= */

.container {
  width: min(100% - 32px, 1000px);
  margin: 0 auto;
  padding: 28px 0 60px;
}

/* =========================
   Free Fire Logo
========================= */

.header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30px;
}

.ff-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220px;
  max-width: 70%;
}

.ff-logo img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 100px;
  object-fit: contain;
}

/* =========================
   Search Form
========================= */

.search-form {
  display: flex;
  align-items: stretch;
  gap: 10px;
  margin-bottom: 26px;
}

.search-form input {
  flex: 1;
  min-width: 0;
  height: 58px;
  padding: 0 20px;
  background: #0b0b0b;
  color: var(--text-color);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  outline: none;
  transition: border-color 0.2s ease;
}

.search-form input::placeholder {
  color: #777777;
}

.search-form input:focus {
  border-color: #666666;
}

.search-form button {
  min-width: 115px;
  padding: 0 24px;
  background: var(--search-red);
  color: #ffffff;
  border: none;
  border-radius: 10px;
  font-weight: 700;
  transition: background 0.2s ease;
}

.search-form button:hover {
  background: #c9000b;
}

.search-form button:active {
  transform: scale(0.98);
}

/* =========================
   Player Profile Card
========================= */

.profile-card,
.info-section {
  background: var(--card-background);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  padding: 24px;
  margin-bottom: 20px;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 18px;
  min-width: 0;
}

/* =========================
   Player Avatar
========================= */

.avatar {
  width: 88px;
  height: 88px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #202020;
  color: #ffffff;
  border: 1px solid #393939;
  border-radius: 50%;
  font-size: 34px;
  font-weight: 800;
  text-transform: uppercase;
}

.avatar img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* =========================
   Player Identity
========================= */

.profile-identity {
  min-width: 0;
  overflow-wrap: anywhere;
}

.profile-identity h1 {
  margin-bottom: 5px;
  color: var(--text-color);
  font-size: clamp(21px, 4vw, 29px);
  font-weight: 750;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.profile-identity p {
  margin-top: 4px;
  color: var(--muted-color);
  font-size: 14px;
  overflow-wrap: anywhere;
}

/* =========================
   Clickable UID
========================= */

.copy-uid {
  color: #ffffff;
  cursor: pointer;
  overflow-wrap: anywhere;
  text-decoration: underline;
  text-decoration-color: #555555;
  text-underline-offset: 4px;
  transition: color 0.2s ease;
}

.copy-uid:hover {
  color: #c9c9c9;
}

/* =========================
   Main Player Stats
========================= */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: 24px;
}

.stat {
  min-width: 0;
  padding: 17px 14px;
  background: var(--inner-background);
  border: 1px solid var(--border-color);
  border-radius: 10px;
}

.stat span {
  display: block;
  margin-bottom: 7px;
  color: var(--muted-color);
  font-size: 12px;
  font-weight: 500;
}

.stat strong {
  display: block;
  color: var(--text-color);
  font-size: clamp(17px, 2.5vw, 23px);
  font-weight: 750;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

/* =========================
   Information Sections
========================= */

.info-section h2 {
  margin-bottom: 18px;
  padding-bottom: 13px;
  color: var(--text-color);
  border-bottom: 1px solid var(--border-color);
  font-size: 18px;
  font-weight: 700;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.info-item {
  min-width: 0;
  padding: 14px 15px;
  background: var(--inner-background);
  border: 1px solid var(--border-color);
  border-radius: 9px;
}

.info-item span {
  display: block;
  margin-bottom: 7px;
  color: var(--muted-color);
  font-size: 12px;
  font-weight: 500;
}

.info-item strong {
  display: block;
  color: #eeeeee;
  font-size: 14px;
  font-weight: 600;
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* =========================
   No Player Found
========================= */

.empty-message {
  padding: 22px;
  background: var(--card-background);
  color: var(--muted-color);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  text-align: center;
}

/* =========================
   Tablet Responsive
========================= */

@media (max-width: 700px) {
  .container {
    width: calc(100% - 24px);
    padding-top: 22px;
  }

  .header {
    margin-bottom: 24px;
  }

  .ff-logo {
    width: 190px;
  }

  .profile-card,
  .info-section {
    padding: 19px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* =========================
   Mobile Responsive
========================= */

@media (max-width: 420px) {
  .container {
    width: calc(100% - 20px);
    padding-top: 18px;
    padding-bottom: 35px;
  }

  .header {
    margin-bottom: 20px;
  }

  .ff-logo {
    width: 165px;
  }

  .search-form {
    gap: 7px;
    margin-bottom: 20px;
  }

  .search-form input {
    height: 50px;
    padding: 0 12px;
    font-size: 13px;
  }

  .search-form button {
    min-width: 82px;
    padding: 0 12px;
    font-size: 13px;
  }

  .profile-card,
  .info-section {
    padding: 15px;
    margin-bottom: 14px;
    border-radius: 11px;
  }

  .profile-header {
    gap: 13px;
  }

  .avatar {
    width: 66px;
    height: 66px;
    font-size: 27px;
  }

  .profile-identity h1 {
    font-size: 20px;
  }

  .profile-identity p {
    font-size: 12px;
  }

  .stats-grid {
    gap: 9px;
    margin-top: 19px;
  }

  .stat {
    padding: 13px 11px;
  }

  .stat span,
  .info-item span {
    font-size: 11px;
  }

  .stat strong {
    font-size: 18px;
  }

  .info-section h2 {
    font-size: 16px;
  }

  .info-grid {
    gap: 9px;
  }

  .info-item {
    padding: 12px 10px;
  }

  .info-item strong {
    font-size: 13px;
  }
}

/* =========================
   Small Screen Search
========================= */

@media (max-width: 340px) {
  .search-form {
    flex-direction: column;
  }

  .search-form button {
    height: 46px;
    width: 100%;
  }

  .profile-header {
    align-items: flex-start;
  }

  .avatar {
    width: 56px;
    height: 56px;
    font-size: 23px;
  }
}

  </style>
</head>
<body>

<main class="container">
  <header class="header">
    <div class="ff-logo">
      <img
        src="https://cdn.wildflamestudio.com/common/web_event/official2/dist/client/img/full_logo.969f536.png"
        alt="Free Fire"
      />
    </div>
  </header>

  <form action="/" method="GET" class="search-form">
    <input
      type="text"
      name="uid"
      placeholder="Enter Free Fire UID"
      value="<%= typeof uid !== 'undefined' ? uid : '' %>"
      inputmode="numeric"
      required
    />
    <button type="submit">🔍 Search</button>
  </form>

  <% if (error) { %>
    <div class="error-message" role="alert">
      ⚠️ <%= error %>
    </div>
  <% } %>

  <% if (player) { %>
    <section class="profile-card">
      <div class="profile-header">
        <div class="avatar">
          <% if (String(player.id) === "2834031346") { %>
            <img
              src="https://scontent.fjsr14-1.fna.fbcdn.net/v/t39.30808-1/861498287_122126727633371477_4517925297852134838_n.jpg?stp=dst-jpg_tt6&cstp=mx1080x1080&ctp=s200x200&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=e99d92&_nc_ohc=-o9IoFp0_6YQ7kNvwGYB15j&_nc_oc=Adr3VM2Ma3BTCOqObLWfdhXKDxqFZWXctG11siRHe82h_-5MN4OKFIijEt2bpBRlyoE&_nc_zt=24&_nc_ht=scontent.fjsr14-1.fna&_nc_gid=CUiH0UXRIOgU34gbXsTsUg&_nc_ss=7b2a8&oh=00_AQSRt2naebdnageZ0ngKyY-da9KJTYlf-nXcYFdoZpaQFA&oe=6AE8306D"
              alt="Player avatar"
            />
          <% } else { %>
            <%= String(player.nickname || "P").charAt(0).toUpperCase() %>
          <% } %>
        </div>

        <div class="profile-identity">
          <h1><%= player.nickname %></h1>

          <p>
            UID:
            <span
              class="copy-uid"
              data-uid="<%= player.id %>"
              title="Click to copy"
            ><%= player.id %></span>
          </p>

          <% if (player.region != null) { %>
            <p>Region: <%= player.region %></p>
          <% } %>
        </div>
      </div>

      <div class="stats-grid">
        <div class="stat">
          <span>🏆 Level</span>
          <strong><%= player.level ?? "—" %></strong>
        </div>

        <div class="stat">
          <span>❤️ Likes</span>
          <strong><%= player.like ?? "—" %></strong>
        </div>

        <div class="stat">
          <span>🎯 BR Rank Points</span>
          <strong><%= player.br_rank_point ?? "—" %></strong>
        </div>

        <div class="stat">
          <span>⚔️ CS Rank Points</span>
          <strong><%= player.cs_rank_point ?? "—" %></strong>
        </div>
      </div>
    </section>

    <% if (player.exp != null || player.credit_score != null) { %>
      <section class="info-section">
        <h2>👤 Account Information</h2>

        <div class="info-grid">
          <% if (player.exp != null) { %>
            <div class="info-item">
              <span>⭐ EXP</span>
              <strong><%= player.exp %></strong>
            </div>
          <% } %>

          <% if (player.credit_score != null) { %>
            <div class="info-item">
              <span>🛡️ Credit Score</span>
              <strong><%= player.credit_score %></strong>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <section class="info-section">
      <h2>🏆 Rank Information</h2>

      <div class="info-grid">
        <div class="info-item">
          <span>🎯 BR Rank</span>
          <strong><%= player.br_rank ?? "—" %></strong>
        </div>

        <div class="info-item">
          <span>🥇 BR Max Rank</span>
          <strong><%= player.br_max_rank ?? "—" %></strong>
        </div>

        <div class="info-item">
          <span>🏆 BR Rank Points</span>
          <strong><%= player.br_rank_point ?? "—" %></strong>
        </div>

        <div class="info-item">
          <span>⚔️ CS Rank</span>
          <strong><%= player.cs_rank ?? "—" %></strong>
        </div>

        <div class="info-item">
          <span>🥇 CS Max Rank</span>
          <strong><%= player.cs_max_rank ?? "—" %></strong>
        </div>

        <div class="info-item">
          <span>🏆 CS Rank Points</span>
          <strong><%= player.cs_rank_point ?? "—" %></strong>
        </div>
      </div>
    </section>

    <% if (
      player.guild_name ||
      player.guild_id != null ||
      player.guild_level != null ||
      player.guild_member != null ||
      player.guild_capacity != null
    ) { %>
      <section class="info-section">
        <h2>🛡️ Guild Information</h2>

        <div class="info-grid">
          <% if (player.guild_name) { %>
            <div class="info-item">
              <span>🛡️ Guild Name</span>
              <strong><%= player.guild_name %></strong>
            </div>
          <% } %>

          <% if (player.guild_id != null) { %>
            <div class="info-item">
              <span>🆔 Guild UID</span>
              <strong
                class="copy-uid"
                data-uid="<%= player.guild_id %>"
                title="Click to copy"
              ><%= player.guild_id %></strong>
            </div>
          <% } %>

          <% if (player.guild_level != null) { %>
            <div class="info-item">
              <span>⭐ Guild Level</span>
              <strong><%= player.guild_level %></strong>
            </div>
          <% } %>

          <% if (player.guild_member != null) { %>
            <div class="info-item">
              <span>👥 Guild Members</span>
              <strong><%= player.guild_member %></strong>
            </div>
          <% } %>

          <% if (player.guild_capacity != null) { %>
            <div class="info-item">
              <span>👥 Guild Capacity</span>
              <strong><%= player.guild_capacity %></strong>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <% if (
      player.guild_leader_name ||
      player.guild_leader_uid != null ||
      player.guild_leader_level != null ||
      player.guild_leader_region
    ) { %>
      <section class="info-section">
        <h2>👑 Guild Leader Profile</h2>

        <div class="info-grid">
          <% if (player.guild_leader_name) { %>
            <div class="info-item">
              <span>👤 Name</span>
              <strong><%= player.guild_leader_name %></strong>
            </div>
          <% } %>

          <% if (player.guild_leader_uid != null) { %>
            <div class="info-item">
              <span>🆔 UID</span>
              <strong
                class="copy-uid"
                data-uid="<%= player.guild_leader_uid %>"
                title="Click to copy"
              ><%= player.guild_leader_uid %></strong>
            </div>
          <% } %>

          <% if (player.guild_leader_level != null) { %>
            <div class="info-item">
              <span>🏆 Level</span>
              <strong><%= player.guild_leader_level %></strong>
            </div>
          <% } %>

          <% if (player.guild_leader_region) { %>
            <div class="info-item">
              <span>🌍 Region</span>
              <strong><%= player.guild_leader_region %></strong>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

  <% } else if (uid && !error) { %>
    <p class="empty-message">🔎 Player data not found.</p>
  <% } %>
</main>

  <script>
    document.querySelectorAll(".copy-uid").forEach((element) => {
      element.addEventListener("click", async () => {
        const uid = element.dataset.uid;

        try {
          await navigator.clipboard.writeText(uid);

          const originalText = element.textContent;
          element.textContent = "Copied!";

          setTimeout(() => {
            element.textContent = originalText;
          }, 1000);
        } catch {
          window.prompt("Copy UID:", uid);
        }
      });
    });
  </script>
</body>
</html>